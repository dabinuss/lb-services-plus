    "sendEmployeeMessage": { "input": ["conversationId", "body", "attachments?", "includeCurrentLocation?", "clientRequestId?"], "inputSchema": { "type": "object", "required": ["conversationId", "body"], "properties": { "conversationId": { "type": "integer", "minimum": 1 }, "body": { "type": "string", "maxLength": 2000 }, "attachments": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 500 } }, "includeCurrentLocation": { "type": "boolean" }, "clientRequestId": { "type": "string", "maxLength": 128 } } }, "result": "InboxMessage", "rate": "sendEmployeeMessage" },
    "getCitizenInbox": { "input": ["cursor?", "limit?"], "inputSchema": { "type": "object", "properties": { "cursor": { "type": "integer", "minimum": 1 }, "limit": { "type": "integer", "minimum": 1, "maximum": 50 } } }, "result": "InboxConversation[]", "rate": "getCitizenInbox" },
    "getConversationMessages": { "input": ["conversationId", "cursor?", "limit?", "citizen?"], "inputSchema": { "type": "object", "required": ["conversationId"], "properties": { "conversationId": { "type": "integer", "minimum": 1 }, "cursor": { "type": "integer", "minimum": 1 }, "limit": { "type": "integer", "minimum": 1, "maximum": 50 }, "citizen": { "type": "boolean" } } }, "result": "ConversationData", "rate": "getConversationMessages" },
    "reactToMessage": { "input": ["messageId", "emoji", "citizen?"], "inputSchema": { "type": "object", "required": ["messageId", "emoji"], "properties": { "messageId": { "type": "integer", "minimum": 1 }, "emoji": { "type": "string", "minLength": 1, "maxLength": 16 }, "citizen": { "type": "boolean" } } }, "result": "MessageReactionUpdate", "rate": "reactToMessage" },
    "createRequest": { "input": ["companyId", "templateId", "values", "locale?", "clientRequestId?"], "inputSchema": { "type": "object", "required": ["companyId", "templateId", "values"], "properties": { "companyId": { "type": "string", "maxLength": 64 }, "templateId": { "type": "string", "maxLength": 64 }, "values": { "type": "object" }, "locale": { "type": "string", "enum": ["en", "de"] }, "clientRequestId": { "type": "string", "maxLength": 128 } } }, "result": "CitizenRequest", "rate": "createRequest" },
    "getMyActivity": { "input": ["limit?"], "inputSchema": { "type": "object", "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 50 } } }, "result": "MyActivity", "rate": "getMyActivity" },
    "getAdminState": { "input": [], "inputSchema": { "type": "object" }, "result": "AdminState", "rate": "getAdminState" },
    "adminSaveCompany": { "input": ["company"], "inputSchema": { "type": "object", "required": ["company"], "properties": { "company": { "type": "object" } } }, "result": "Company", "rate": "adminSaveCompany" },
    "adminDeleteCompany": { "input": ["companyId"], "inputSchema": { "type": "object", "required": ["companyId"], "properties": { "companyId": { "type": "string", "minLength": 2, "maxLength": 64 } } }, "result": "Identifier", "rate": "adminDeleteCompany" },
    "adminRestoreCompany": { "input": ["companyId"], "inputSchema": { "type": "object", "required": ["companyId"], "properties": { "companyId": { "type": "string", "minLength": 2, "maxLength": 64 } } }, "result": "Company", "rate": "adminRestoreCompany" },
    "adminUpdateSettings": { "input": ["settings"], "inputSchema": { "type": "object", "required": ["settings"], "properties": { "settings": { "type": "object" } } }, "result": "AppSettings", "rate": "adminUpdateSettings" },
    "adminUpdateCategory": { "input": ["categoryId", "requestCompetition"], "inputSchema": { "type": "object", "required": ["categoryId", "requestCompetition"], "properties": { "categoryId": { "type": "string", "maxLength": 64 }, "requestCompetition": { "type": "boolean" } } }, "result": "Category", "rate": "adminUpdateCategory" },
    "deleteRequest": { "input": ["id"], "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } }, "result": "Identifier", "rate": "deleteRequest" },
    "deleteConversation": { "input": ["id"], "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } }, "result": "Identifier", "rate": "deleteConversation" },
    "deleteMessage": { "input": ["id"], "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } }, "result": "Identifier", "rate": "deleteMessage" }
  },
  "exports": {
    "GetCompany": { "input": ["companyId"], "result": "Company", "rate": "externalRead" },
    "GetCompanyNumbers": { "input": ["companyId"], "result": "CompanyNumber[]", "rate": "externalRead" },
    "GetCompanyEmployees": { "input": ["companyId"], "result": "EmployeeIntegration[]", "rate": "externalRead" },
    "GetRequest": { "input": ["requestId"], "result": "RequestIntegration", "rate": "externalRead" },
    "GetCompanyRequests": { "input": ["companyId", "options?"], "result": "RequestIntegration[]", "rate": "externalList" },
    "CreateRequest": { "input": ["source", "payload"], "result": "RequestIntegration", "rate": "externalWrite" },
    "AcceptRequest": { "input": ["source", "requestId"], "result": "RequestIntegration", "rate": "externalWrite" },
    "DeclineRequest": { "input": ["source", "requestId"], "result": "RequestIntegration|Identifier", "rate": "externalWrite" },
    "ReturnRequest": { "input": ["source", "requestId"], "result": "RequestIntegration", "rate": "externalWrite" },
    "TransitionRequest": { "input": ["source", "requestId", "phaseId"], "result": "RequestIntegration", "rate": "externalWrite" },
    "SendCompanyMessage": { "input": ["source", "payload"], "result": "InboxMessage", "rate": "externalWrite" }
  },
  "serverEvents": ["requestLifecycle", "requestCreated", "requestUpdated", "requestAccepted", "requestPhaseChanged", "requestReturned", "requestCompleted", "requestCancelled", "requestDeleted", "messageReceived"],
  "pushMessages": ["company.updated", "company.deleted", "settings.updated", "category.updated", "employee.updated", "employee.removed", "session.invalidated", "call.offer", "call.offer.removed", "call.accepted.local", "call.queue", "request.offer", "request.offer.removed", "request.updated", "request.citizen.updated", "inbox.message", "inbox.reaction", "inbox.deleted", "inbox.message.deleted"]
}
