{
  "version": 11,
  "actions": {
    "getInitialState": { "input": [], "inputSchema": { "type": "object" }, "result": "InitialState", "rate": "getInitialState" },
    "enterDuty": { "input": [], "inputSchema": { "type": "object" }, "result": "SessionState", "rate": "enterDuty" },
    "leaveDuty": { "input": [], "inputSchema": { "type": "object" }, "result": "SessionState", "rate": "leaveDuty" },
    "updateStatus": { "input": ["status"], "inputSchema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["available", "occupied", "on_break"] } } }, "result": "Employee", "rate": "updateStatus" },
    "toggleDispatch": { "input": ["enabled"], "inputSchema": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } }, "result": "Employee", "rate": "toggleDispatch" },
    "updateCompanyOperations": { "input": ["companyId", "patch"], "inputSchema": { "type": "object", "required": ["companyId", "patch"], "properties": { "companyId": { "type": "string", "minLength": 2, "maxLength": 64 }, "patch": { "type": "object" } } }, "result": "Company", "rate": "updateCompanyOperations" },
    "updateNumberOperations": { "input": ["numbers"], "inputSchema": { "type": "object", "required": ["numbers"], "properties": { "numbers": { "type": "array", "maxItems": 10, "items": { "type": "object" } } } }, "result": "Company", "rate": "updateNumberOperations" },
    "toggleDispatchLine": { "input": ["numberId", "enabled"], "inputSchema": { "type": "object", "required": ["numberId", "enabled"], "properties": { "numberId": { "type": "string", "minLength": 2, "maxLength": 64 }, "enabled": { "type": "boolean" } } }, "result": "Employee", "rate": "toggleDispatchLine" },
    "startCompanyCall": { "input": ["companyId", "numberId?"], "inputSchema": { "type": "object", "required": ["companyId"], "properties": { "companyId": { "type": "string", "minLength": 2, "maxLength": 64 }, "numberId": { "type": "string", "maxLength": 64 } } }, "result": "PhoneTarget", "rate": "startCompanyCall" },
    "getEmployeeContact": { "input": ["targetSource"], "inputSchema": { "type": "object", "required": ["targetSource"], "properties": { "targetSource": { "type": "integer", "minimum": 1 } } }, "result": "PhoneTarget", "rate": "getEmployeeContact" },
    "registerIncomingCall": { "input": ["number", "callToken"], "inputSchema": { "type": "object", "required": ["number", "callToken"], "properties": { "number": { "type": "string", "minLength": 1, "maxLength": 32 }, "callToken": { "type": "string", "minLength": 1, "maxLength": 96 } } }, "result": "CompanyCall", "rate": "registerIncomingCall" },
    "acceptCall": { "input": ["id"], "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } }, "result": "CompanyCall", "rate": "acceptCall" },
    "declineCall": { "input": ["id"], "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } }, "result": "Identifier", "rate": "declineCall" },
    "endCustomCall": { "input": ["callToken", "reoffer?"], "inputSchema": { "type": "object", "required": ["callToken"], "properties": { "callToken": { "type": "string", "minLength": 1, "maxLength": 96 }, "reoffer": { "type": "boolean" } } }, "result": "Ended", "rate": "endCustomCall" },
    "getRequestOptions": { "input": ["companyId", "locale?"], "inputSchema": { "type": "object", "required": ["companyId"], "properties": { "companyId": { "type": "string", "minLength": 2, "maxLength": 64 }, "locale": { "type": "string", "enum": ["en", "de"] } } }, "result": "RequestSettings", "rate": "getRequestOptions" },
    "getCompanyWorkspace": { "input": ["sections?", "cursors?", "conversationNumberId?", "seenCallId?", "includeSummary?", "limit?", "locale?"], "inputSchema": { "type": "object", "properties": { "sections": { "type": "array", "maxItems": 3, "items": { "type": "string", "enum": ["conversations", "requests", "calls"] } }, "cursors": { "type": "object" }, "conversationNumberId": { "type": "string", "maxLength": 64 }, "seenCallId": { "type": "integer", "minimum": 0 }, "includeSummary": { "type": "boolean" }, "limit": { "type": "integer", "minimum": 1, "maximum": 50 }, "locale": { "type": "string", "enum": ["en", "de"] } } }, "result": "CompanyWorkspace", "rate": "getCompanyWorkspace" },
    "acceptRequest": { "input": ["id"], "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } }, "result": "CompanyRequest", "rate": "acceptRequest" },
    "declineRequest": { "input": ["id"], "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } }, "result": "Identifier", "rate": "declineRequest" },
    "transitionRequest": { "input": ["id", "phaseId"], "inputSchema": { "type": "object", "required": ["id", "phaseId"], "properties": { "id": { "type": "integer", "minimum": 1 }, "phaseId": { "type": "string", "minLength": 1, "maxLength": 64 } } }, "result": "CompanyRequest", "rate": "transitionRequest" },
    "returnRequest": { "input": ["id"], "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } }, "result": "CompanyRequest", "rate": "returnRequest" },
    "cancelRequest": { "input": ["id"], "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } }, "result": "CitizenRequest", "rate": "cancelRequest" },
    "updateRequestSettings": { "input": ["settings"], "inputSchema": { "type": "object", "required": ["settings"], "properties": { "settings": { "type": "object" } } }, "result": "RequestSettings", "rate": "updateRequestSettings" },
